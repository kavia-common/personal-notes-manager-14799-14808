# Public configuration for the frontend. Do not put secrets here.
NEXT_PUBLIC_APP_NAME=Notes
# Base URL for backend API. Defaults to /api (or local mock/localStorage).
# If you integrate a real backend, set to its origin, e.g. https://api.example.com
NEXT_PUBLIC_API_BASE_URL=/api
# Site URL for redirects (used by auth providers if integrated)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
